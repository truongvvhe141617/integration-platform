{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "${REDIS_HOST}:6379"
  },
  "Services": {
    "ConfigService": "${CONFIG_SERVICE_URL}"
  },
  "Connectors": {
    "ConfigMode": "api",
    "ConfigDirectory": "/app/configs",
    "PluginDirectory": "/app/plugins"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "Port": 5672,
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASS}",
    "VirtualHost": "/"
  }
}
