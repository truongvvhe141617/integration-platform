{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}"
  },
  "ReverseProxy": {
    "Clusters": {
      "integration-cluster": {
        "Destinations": {
          "d1": { "Address": "${INTEGRATION_SERVICE_URL}" }
        }
      },
      "config-cluster": {
        "Destinations": {
          "d1": { "Address": "${CONFIG_SERVICE_URL}" }
        }
      },
      "business-cluster": {
        "Destinations": {
          "d1": { "Address": "${BUSINESS_SERVICE_URL}" }
        }
      }
    }
  }
}
